// Возвращает факт исполнителя по задачам за неделю: по одной строке на пару "день + задача".
// Учитываются проведенные документы ввода факта, не помеченные на удаление, с датой в границах недели.
// Чтение выполняется с правами текущего пользователя: задачи, недоступные ему, в результат не попадают.
//
// Параметры:
//  Исполнитель   - СправочникСсылка.Пользователи - исполнитель, чей факт выводится.
//  ДатаНедели    - Дата - дата любого дня недели; неделя считается с понедельника по воскресенье.
//
// Возвращаемое значение:
//  ТаблицаЗначений - факт за неделю, отсортированный по дню и задаче:
//   * День                  - Дата - начало дня.
//   * Задача                - СправочникСсылка.узЗадачи - задача.
//   * ЗадачаПредставление   - Строка - номер, наименование задачи и сумма часов: код с символом "#" без пробелов, наименование, затем " | " и часы, например "#1234 Оплатить интернет | 2,50".
//   * Часы                 - Число - сумма факта по всем строкам данных документов за день.
//   * КоличествоДокументов  - Число - количество документов за день по задаче.
//   * КоличествоСтрокДанных - Число - количество строк данных во всех этих документах.
//   * Множественная         - Булево - Истина, если документов больше одного или в документе несколько строк данных.
//   * Документ              - ДокументСсылка.узВводФактаПоЗадаче - документ записи; пусто для множественной записи.
//
Функция ПолучитьДанныеНедели(Исполнитель, ДатаНедели) Экспорт

	НачалоПериода = НачалоНедели(ДатаНедели);
	КонецПериода = КонецНедели(ДатаНедели);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(ДокументыФакта.Дата, ДЕНЬ) КАК День,
	|	ДокументыФакта.Задача КАК Задача,
	|	ДокументыФакта.Задача.Код КАК КодЗадачи,
	|	ДокументыФакта.Задача.Наименование КАК НаименованиеЗадачи,
	|	СУММА(СтрокиФакта.Факт) КАК Часы,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыФакта.Ссылка) КАК КоличествоДокументов,
	|	КОЛИЧЕСТВО(СтрокиФакта.НомерСтроки) КАК КоличествоСтрокДанных,
	|	МАКСИМУМ(ДокументыФакта.Ссылка) КАК ПоследнийДокумент
	|ИЗ
	|	Документ.узВводФактаПоЗадаче.Данные КАК СтрокиФакта
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.узВводФактаПоЗадаче КАК ДокументыФакта
	|		ПО СтрокиФакта.Ссылка = ДокументыФакта.Ссылка
	|ГДЕ
	|	ДокументыФакта.Исполнитель = &Исполнитель
	|	И ДокументыФакта.Проведен
	|	И НЕ ДокументыФакта.ПометкаУдаления
	|	И ДокументыФакта.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ДокументыФакта.Дата, ДЕНЬ),
	|	ДокументыФакта.Задача,
	|	ДокументыФакта.Задача.Код,
	|	ДокументыФакта.Задача.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	День,
	|	Задача";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("День");
	Результат.Колонки.Добавить("Задача");
	Результат.Колонки.Добавить("ЗадачаПредставление");
	Результат.Колонки.Добавить("Часы");
	Результат.Колонки.Добавить("КоличествоДокументов");
	Результат.Колонки.Добавить("КоличествоСтрокДанных");
	Результат.Колонки.Добавить("Множественная");
	Результат.Колонки.Добавить("Документ");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка,
			"День, Задача, Часы, КоличествоДокументов, КоличествоСтрокДанных");
		НоваяСтрока.ЗадачаПредставление = "#" + Формат(Выборка.КодЗадачи, "ЧГ=0") + " " + Выборка.НаименованиеЗадачи
			+ " | " + Формат(Выборка.Часы, "ЧДЦ=2; ЧН=0; ЧГ=");

		НоваяСтрока.Множественная = Выборка.КоличествоДокументов > 1 ИЛИ Выборка.КоличествоСтрокДанных > 1;
		Если НЕ НоваяСтрока.Множественная Тогда
			НоваяСтрока.Документ = Выборка.ПоследнийДокумент;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Переносит единственную запись "исполнитель + задача + день" на другой день: меняет дату документа ввода факта,
// сохраняя время суток, сдвигает ДатаНачала и ДатаОкончания строки данных на ту же разницу,
// определяет спринт по новой дате и перепроводит документ. Часы не меняются.
// Если запись отсутствует или множественная (несколько документов либо строк данных), перенос отклоняется.
// Перенос на тот же день ничего не меняет и считается успешным.
//
// Параметры:
//  Исполнитель - СправочникСсылка.Пользователи - исполнитель записи.
//  Задача      - СправочникСсылка.узЗадачи - задача записи.
//  СДня        - Дата - день записи (любое время внутри дня).
//  НаДень      - Дата - день, на который переносится запись (любое время внутри дня).
//
// Возвращаемое значение:
//  Структура - результат переноса:
//   * Успех       - Булево - Истина, если запись перенесена (или день не изменился).
//   * ТекстОшибки - Строка - причина отказа, пусто при успехе.
//
Функция ПеренестиЗапись(Исполнитель, Задача, СДня, НаДень) Экспорт

	Результат = Новый Структура("Успех, ТекстОшибки", Ложь, "");

	Если НачалоДня(СДня) = НачалоДня(НаДень) Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Записи = ДокументыЗаписиДня(Исполнитель, Задача, СДня);
	Если Записи.Количество() = 0 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'За этот день по задаче нет проведенного документа ввода факта.'");
		Возврат Результат;
	КонецЕсли;

	Если Записи.Количество() > 1 ИЛИ Записи[0].КоличествоСтрокДанных > 1 Тогда
		Результат.ТекстОшибки = НСтр("ru = 'За день по задаче несколько записей факта, перенос на доске недоступен. Откройте документы двойным щелчком.'");
		Возврат Результат;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);

	НачатьТранзакцию();
	Попытка

		ДокументФакта = Записи[0].Документ.ПолучитьОбъект();

		// Время суток сохраняется: новая дата это начало целевого дня плюс время суток прежней даты.
		ПрежняяДата = ДокументФакта.Дата;
		НоваяДата = НачалоДня(НаДень) + (ПрежняяДата - НачалоДня(ПрежняяДата));
		Сдвиг = НоваяДата - ПрежняяДата;

		ДокументФакта.Дата = НоваяДата;

		СтрокаДанных = ДокументФакта.Данные[0];
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаНачала) Тогда
			СтрокаДанных.ДатаНачала = СтрокаДанных.ДатаНачала + Сдвиг;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДанных.ДатаОкончания) Тогда
			СтрокаДанных.ДатаОкончания = СтрокаДанных.ДатаОкончания + Сдвиг;
		КонецЕсли;
		СтрокаДанных.Спринт = Справочники.узСпринты.ПолучитьТекущийСпринтДляЗадачи(КонецДня(НоваяДата), Задача);

		Если НЕ ДокументФакта.ПроверитьЗаполнение() Тогда
			ВызватьИсключение ТекстСообщенийПользователю();
		КонецЕсли;

		ДокументФакта.Записать(РежимЗаписиДокумента.Проведение);

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();

		Результат.ТекстОшибки = ТекстСообщенийПользователю();
		Если НЕ ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда
			Результат.ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		Возврат Результат;

	КонецПопытки;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Возвращает проведенные документы ввода факта исполнителя по задаче за день.
//
// Параметры:
//  Исполнитель - СправочникСсылка.Пользователи - исполнитель.
//  Задача      - СправочникСсылка.узЗадачи - задача.
//  День        - Дата - день (любое время внутри дня).
//
// Возвращаемое значение:
//  ТаблицаЗначений - документы записи:
//   * Документ              - ДокументСсылка.узВводФактаПоЗадаче - документ.
//   * КоличествоСтрокДанных - Число - количество строк данных документа.
//
Функция ДокументыЗаписиДня(Исполнитель, Задача, День)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДокументыФакта.Ссылка КАК Документ,
	|	КОЛИЧЕСТВО(СтрокиФакта.НомерСтроки) КАК КоличествоСтрокДанных
	|ИЗ
	|	Документ.узВводФактаПоЗадаче КАК ДокументыФакта
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.узВводФактаПоЗадаче.Данные КАК СтрокиФакта
	|		ПО ДокументыФакта.Ссылка = СтрокиФакта.Ссылка
	|ГДЕ
	|	ДокументыФакта.Исполнитель = &Исполнитель
	|	И ДокументыФакта.Задача = &Задача
	|	И ДокументыФакта.Проведен
	|	И НЕ ДокументыФакта.ПометкаУдаления
	|	И ДокументыФакта.Дата МЕЖДУ &НачалоДня И &КонецДня
	|СГРУППИРОВАТЬ ПО
	|	ДокументыФакта.Ссылка";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(День));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(День));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Собирает тексты накопленных сообщений пользователю в одну строку и очищает их.
//
// Возвращаемое значение:
//  Строка - тексты сообщений через перевод строки.
//
Функция ТекстСообщенийПользователю()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции
