
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Объект.Исполнитель = Пользователи.ТекущийПользователь();
	Объект.НачалоНедели = НачалоНедели(ТекущаяДатаСеанса());

	СоздатьЭлементыДней();
	ОбновитьДанныеНедели();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОставитьВКонтекстномМенюТолькоДобавитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	// Собственное оповещение доски (после изменения часов) повторно данные не перечитывает.
	Если ИмяСобытия = "узВводФактаПоЗадачеЗаписан" И Источник <> ЭтотОбъект Тогда
		ОбновитьДанныеНедели();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПредыдущаяНеделя(Команда)

	СменитьНеделюНаСервере("Назад");

КонецПроцедуры

&НаКлиенте
Процедура СледующаяНеделя(Команда)

	СменитьНеделюНаСервере("Вперед");

КонецПроцедуры

&НаКлиенте
Процедура КСегодняшнемуДню(Команда)

	СменитьНеделюНаСервере("Сегодня");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

// Стандартное «Добавить» (в том числе Ins и копирование строки) вместо пустой строки открывает
// штатную форму ввода факта на день этой таблицы.
&НаКлиенте
Процедура ТаблицаДняПередНачаломДобавления(Элемент, Отказ, Копирование)

	Отказ = Истина;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Исполнитель", Объект.Исполнитель);
	ПараметрыФормы.Вставить("Дата", Элемент.ОтборСтрок.День + 12 * 3600);

	ОткрытьФорму("Документ.узВводФактаПоЗадаче.Форма.ФормаДокументаВводСЗадачи", ПараметрыФормы, ЭтотОбъект, , , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Двойной щелчок: для одиночной записи открывает ее документ, для множественной - список документов дня.
&НаКлиенте
Процедура ТаблицаДняВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Данные = Элемент.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Если Данные.Множественная Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Исполнитель, Задача", Объект.Исполнитель, Данные.Задача));
		ПараметрыФормы.Вставить("НачалоПериода", НачалоДня(Данные.День));
		ПараметрыФормы.Вставить("КонецПериода", КонецДня(Данные.День));
		ОткрытьФорму("Документ.узВводФактаПоЗадаче.Форма.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
	Иначе
		ОткрытьФорму("Документ.узВводФактаПоЗадаче.Форма.ФормаДокумента",
			Новый Структура("Ключ", Данные.Документ), ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Перетаскивание принимается как в канбан-доске; допустимость переноса проверяется в обработчике Перетаскивание.
&НаКлиенте
Процедура ТаблицаДняПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

	СтандартнаяОбработка = Ложь;

КонецПроцедуры

// Перенос записи в день таблицы, на которую перетащили строку. Множественные записи не переносятся.
&НаКлиенте
Процедура ТаблицаДняПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

	СтандартнаяОбработка = Ложь;

	НаДень = Элемент.ОтборСтрок.День;
	Перенесено = Ложь;

	Для Каждого ДанныеИсточника Из ПараметрыПеретаскивания.Значение Цикл

		Если ДанныеИсточника.День = НаДень Тогда
			Продолжить;
		КонецЕсли;

		Если ДанныеИсточника.Множественная Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Запись с несколькими документами или строками данных перенести нельзя.'"));
			Продолжить;
		КонецЕсли;

		Результат = ПеренестиЗаписьНаСервере(Объект.Исполнитель, ДанныеИсточника.Задача, ДанныеИсточника.День, НаДень);
		Если Результат.Успех Тогда
			Перенесено = Истина;
		Иначе
			ПоказатьПредупреждение(, Результат.ТекстОшибки);
		КонецЕсли;

	КонецЦикла;

	Если Перенесено Тогда
		ОбновитьДанныеНедели();
		Оповестить("узВводФактаПоЗадачеЗаписан", , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

// Удалять строки с доски нельзя: факт обнуляется вводом 0.
&НаКлиенте
Процедура ТаблицаДняПередУдалением(Элемент, Отказ)

	Отказ = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает для каждого дня недели группу формы и таблицу с отбором строк по дню.
// Элементы создаются один раз, при смене недели меняются заголовки и отбор строк.
&НаСервере
Процедура СоздатьЭлементыДней()

	Для НомерДня = 1 По 7 Цикл

		ИмяГруппы = "ГруппаДень" + НомерДня;
		ИмяТаблицы = "ТаблицаДень" + НомерДня;

		ГруппаДня = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Элементы.ГруппаДни);
		ГруппаДня.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаДня.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		ГруппаДня.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
		ГруппаДня.ОтображатьЗаголовок = Истина;

		ТаблицаДня = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), ГруппаДня);
		ТаблицаДня.ПутьКДанным = "Объект.ТЧФакт";
		ТаблицаДня.ИзменятьПорядокСтрок = Ложь;
		ТаблицаДня.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ТаблицаДня.Шапка = Ложь;
		ТаблицаДня.ГоризонтальнаяПолосаПрокрутки = ИспользованиеПолосыПрокрутки.НеИспользовать;
		ТаблицаДня.РежимВыделенияСтроки = РежимВыделенияСтрокиТаблицы.Строка;
		ТаблицаДня.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;
		ТаблицаДня.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
		ТаблицаДня.УстановитьДействие("ПередНачаломДобавления", "ТаблицаДняПередНачаломДобавления");
		ТаблицаДня.УстановитьДействие("ПередУдалением", "ТаблицаДняПередУдалением");
		ТаблицаДня.УстановитьДействие("ПриНачалеРедактирования", "ТаблицаДняПриНачалеРедактирования");
		ТаблицаДня.УстановитьДействие("ПриОкончанииРедактирования", "ТаблицаДняПриОкончанииРедактирования");
		ТаблицаДня.УстановитьДействие("ПередНачаломИзменения", "ТаблицаДняПередНачаломИзменения");
		ТаблицаДня.УстановитьДействие("Выбор", "ТаблицаДняВыбор");
		ТаблицаДня.УстановитьДействие("ПроверкаПеретаскивания", "ТаблицаДняПроверкаПеретаскивания");
		ТаблицаДня.УстановитьДействие("Перетаскивание", "ТаблицаДняПеретаскивание");

		ПолеЗадачи = Элементы.Добавить(ИмяТаблицы + "Задача", Тип("ПолеФормы"), ТаблицаДня);
		ПолеЗадачи.Вид = ВидПоляФормы.ПолеВвода;
		ПолеЗадачи.ПутьКДанным = "Объект.ТЧФакт.ЗадачаПредставление";
		ПолеЗадачи.ТолькоПросмотр = Истина;
		// Номер и наименование задачи в одной колонке: не должны раздвигать колонку дня, длинный текст переносится на вторую строку.
		ПолеЗадачи.Ширина = 22;
		ПолеЗадачи.АвтоМаксимальнаяШирина = Ложь;
		ПолеЗадачи.МаксимальнаяШирина = 26;
		ПолеЗадачи.МногострочныйРежим = Истина;
		ПолеЗадачи.Высота = 2;
		ПолеЗадачи.РастягиватьПоГоризонтали = Истина;

	КонецЦикла;

КонецПроцедуры

// В контекстном меню таблиц дней остается только стандартное «Добавить»: поиск, копирование,
// удаление и прочие стандартные команды на доске не нужны. Стандартные элементы меню появляются
// только после построения формы, поэтому процедура вызывается из ПриОткрытии, а не из ПриСозданииНаСервере
// (так же сделано в обработке узКанбанДоска).
&НаСервере
Процедура ОставитьВКонтекстномМенюТолькоДобавитьНаСервере()

	Для НомерДня = 1 По 7 Цикл

		КонтекстноеМеню = Элементы["ТаблицаДень" + НомерДня].КонтекстноеМеню;
		Для Каждого ЭлементМеню Из КонтекстноеМеню.ПодчиненныеЭлементы Цикл
			ЭлементМеню.Видимость = СтрНайти(ЭлементМеню.Имя, "Добавить") > 0;
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Перечитывает факт недели в табличную часть и обновляет заголовки и отбор строк.
&НаСервере
Процедура ОбновитьДанныеНедели()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = ОбработкаОбъект.ПолучитьДанныеНедели(Объект.Исполнитель, Объект.НачалоНедели);
	Объект.ТЧФакт.Загрузить(Данные);

	ОбновитьЗаголовкиИОтбор();

КонецПроцедуры

// Задает отбор строк и заголовки групп (дата, день недели, итог дня).
&НаСервере
Процедура ОбновитьЗаголовкиИОтбор()

	НазванияДней = СтрРазделить(НСтр("ru = 'Пн,Вт,Ср,Чт,Пт,Сб,Вс'"), ",");
	ЦветВыходного = ЦветаСтиля.узЦветВыходного; 
	ЦветБудни = ЦветаСтиля.узЦветБудни;

	// Средняя кнопка навигации называется периодом показанной недели и возвращает к текущей неделе.
	Элементы.ФормаКСегодняшнемуДню.Заголовок = Формат(ДеньПоказаннойНедели(1), "ДФ=dd.MM") + " - "
		+ Формат(ДеньПоказаннойНедели(7), "ДФ=dd.MM");

	Для НомерДня = 1 По 7 Цикл

		День = ДеньПоказаннойНедели(НомерДня);
		ИтогДня = 0;
		Для Каждого СтрокаФакта Из Объект.ТЧФакт.НайтиСтроки(Новый Структура("День", День)) Цикл
			ИтогДня = ИтогДня + СтрокаФакта.Часы;
		КонецЦикла;

		Элементы["ТаблицаДень" + НомерДня].ОтборСтрок = Новый ФиксированнаяСтруктура("День", День);

		ЭтоВыходной = НомерДня > 5;
		Элементы["ТаблицаДень" + НомерДня].ЦветФона = ?(ЭтоВыходной, ЦветВыходного, ЦветБудни);

		ЗаголовокДня = СтрШаблон("%1, %2 - %3 ч",
			Формат(День, "ДФ=dd.MM"),
			НазванияДней[НомерДня - 1],
			Формат(ИтогДня, "ЧДЦ=2; ЧН=0; ЧГ="));
		Элементы["ГруппаДень" + НомерДня].Заголовок = ЗаголовокДня;

	КонецЦикла;

КонецПроцедуры

// Возвращает начало дня недели с указанным номером (1 - понедельник) для показанной недели.
&НаСервере
Функция ДеньПоказаннойНедели(НомерДня)

	Возврат НачалоДня(Объект.НачалоНедели + (НомерДня - 1) * 86400 + 12 * 3600);

КонецФункции

&НаСервере
Функция ПеренестиЗаписьНаСервере(Исполнитель, Задача, СДня, НаДень)

	Возврат РеквизитФормыВЗначение("Объект").ПеренестиЗапись(Исполнитель, Задача, СДня, НаДень);

КонецФункции

&НаСервере
Процедура СменитьНеделюНаСервере(Режим)

	Если Режим = "Назад" Тогда
		Объект.НачалоНедели = НачалоНедели(Объект.НачалоНедели - 1);
	ИначеЕсли Режим = "Вперед" Тогда
		Объект.НачалоНедели = КонецНедели(Объект.НачалоНедели) + 1;
	Иначе
		Объект.НачалоНедели = НачалоНедели(ТекущаяДатаСеанса());
	КонецЕсли;

	ОбновитьДанныеНедели();

КонецПроцедуры

#КонецОбласти
