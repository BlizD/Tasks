Функция ПодставитьСсылкиНаЗадачи(Знач Текст) Экспорт
	
	ЗаменитьТекст = Ложь;
	НовыйТекст = Неопределено;
	
	Результат = Новый Структура();
	Результат.Вставить("ЗаменитьТекст", ЗаменитьТекст);
	Результат.Вставить("НовыйТекст", НовыйТекст);
	
	ЧислоУказанныхЗадач = СтрЧислоВхождений(Текст, "#");
	Если ЧислоУказанныхЗадач = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаЗамен = Новый ТаблицаЗначений();
	ТаблицаЗамен.Колонки.Добавить("ПодстрокаПоиска");
	ТаблицаЗамен.Колонки.Добавить("ПодстрокаЗамены");
	
	НовыйТекст = Текст;
	Для НомерВхождения = 1 По ЧислоУказанныхЗадач Цикл
		
		ПозРешетка = СтрНайти(НовыйТекст, "#", , , НомерВхождения);
		НомерЗадачи = "";
		
		НомерСимвола = ПозРешетка + 1;
		Символ = Сред(НовыйТекст, НомерСимвола, 1);
		Пока Символ <> ""
			И КодСимвола(Символ) >= 48
			И КодСимвола(Символ) <= 57 Цикл
			
			НомерЗадачи = НомерЗадачи + Символ;
			НомерСимвола = НомерСимвола + 1;
			Символ = Сред(НовыйТекст, НомерСимвола, 1);
		КонецЦикла;
		
		ТекстНомерЗадачи = "#" + НомерЗадачи;
		// Код задачи - число из 11 цифр (CodeLength справочника узЗадачи);
		// более длинные последовательности кодом быть не могут.
		Если НЕ ОбщегоНазначенияКлиентСервер.ЭтоЧисло(НомерЗадачи)
			Или СтрДлина(НомерЗадачи) > 11 Тогда
			Продолжить;
		КонецЕсли;
		НомерЧислом = Число(НомерЗадачи);
		
		СсылкаНаЗадачу = Справочники.узЗадачи.НайтиПоКоду(НомерЧислом);
		Если НЕ ЗначениеЗаполнено(СсылкаНаЗадачу) Тогда
			Продолжить;
		КонецЕсли;
		ЗаменитьТекст = Истина;
		
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаЗадачу);
		
		ТекстСсылка = "<a href=" + НавигационнаяСсылка + " style='text-decoration: underline'>" + ТекстНомерЗадачи + "</a>";
		
		СтрокаЗамены = ТаблицаЗамен.Добавить();
		СтрокаЗамены.ПодстрокаПоиска = ТекстНомерЗадачи;
		СтрокаЗамены.ПодстрокаЗамены = ТекстСсылка;
	КонецЦикла;
	
	// Дубликаты подстрок поиска приводят к повторной замене уже вставленных ссылок
	Индекс = 0;
	Пока Индекс < ТаблицаЗамен.Количество() Цикл
		ПодстрокаПоиска = ТаблицаЗамен[Индекс].ПодстрокаПоиска;
		ИндексДубля = Индекс + 1;
		Пока ИндексДубля < ТаблицаЗамен.Количество() Цикл
			Если ТаблицаЗамен[ИндексДубля].ПодстрокаПоиска = ПодстрокаПоиска Тогда
				ТаблицаЗамен.Удалить(ИндексДубля);
			Иначе
				ИндексДубля = ИндексДубля + 1;
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Для Каждого СтрокаЗамены Из ТаблицаЗамен Цикл
		НовыйТекст = СтрЗаменить(НовыйТекст, СтрокаЗамены.ПодстрокаПоиска, СтрокаЗамены.ПодстрокаЗамены);
	КонецЦикла;
	
	Результат.Вставить("ЗаменитьТекст", ЗаменитьТекст);
	Результат.Вставить("НовыйТекст", НовыйТекст);
	Возврат Результат;
	
КонецФункции
