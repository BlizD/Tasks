
&НаСервере
Процедура КомандаОбновитьСтатусНаСервере()
	
	КоличествоОбновленных = 0;
	
	Для НомерСтроки = 1 По ТабДок.ВысотаТаблицы Цикл
		
		КодЗадачиТекст = СокрЛП(ТабДок.Область(НомерСтроки, 1).Текст);
		СтатусТекст = СокрЛП(ТабДок.Область(НомерСтроки, 2).Текст);
		
		Если НЕ ЗначениеЗаполнено(КодЗадачиТекст)
			И НЕ ЗначениеЗаполнено(СтатусТекст) Тогда
			Продолжить;
		КонецЕсли;
		
		КодЗадачи = КодЗадачиИзТекстаЯчейки(КодЗадачиТекст);
		Если КодЗадачи = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗадачаСсылка = Справочники.узЗадачи.НайтиПоКоду(КодЗадачи);
		Если НЕ ЗначениеЗаполнено(ЗадачаСсылка) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Строка %1: не найдена задача с кодом %2.", НомерСтроки, КодЗадачиТекст));
			Продолжить;
		КонецЕсли;
		
		СтатусСсылка = НайтиСтатусПоТекстуЯчейки(СтатусТекст);
		Если НЕ ЗначениеЗаполнено(СтатусСсылка) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Строка %1: не найден статус ""%2"".", НомерСтроки, СтатусТекст));
			Продолжить;
		КонецЕсли;
		
		Если ЗадачаСсылка.Статус = СтатусСсылка Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ЗадачаОбъект = ЗадачаСсылка.ПолучитьОбъект();
			ЗадачаОбъект.Статус = СтатусСсылка;
			ЗадачаОбъект.Записать();
			КоличествоОбновленных = КоличествоОбновленных + 1;
		Исключение
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон("Строка %1: не удалось обновить статус задачи %2. %3",
					НомерСтроки,
					КодЗадачиТекст,
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
		
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон("Обновлено статусов: %1.", КоличествоОбновленных));
	
КонецПроцедуры
 
&НаКлиенте
Процедура КомандаОбновитьСтатус(Команда)
	КомандаОбновитьСтатусНаСервере();
КонецПроцедуры
 
&НаСервереБезКонтекста
Функция КодЗадачиИзТекстаЯчейки(Знач КодЗадачиТекст)
	
	Если НЕ ЗначениеЗаполнено(КодЗадачиТекст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаКода = СтрЗаменить(КодЗадачиТекст, Символы.НПП, "");
	СтрокаКода = СтрЗаменить(СтрокаКода, " ", "");
	Если СтрНачинаетсяС(СтрокаКода, "#") Тогда
		СтрокаКода = Сред(СтрокаКода, 2);
	КонецЕсли;
	
	Попытка
		Возврат Число(СтрокаКода);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиСтатусПоТекстуЯчейки(Знач СтатусТекст)
	
	Если НЕ ЗначениеЗаполнено(СтатусТекст) Тогда
		Возврат Справочники.узСтатусыЗадачи.ПустаяСсылка();
	КонецЕсли;
	
	СтатусСсылка = Справочники.узСтатусыЗадачи.НайтиПоНаименованию(СтатусТекст, Истина);
	Если ЗначениеЗаполнено(СтатусСсылка) Тогда
		Возврат СтатусСсылка;
	КонецЕсли;
	
	Возврат Справочники.узСтатусыЗадачи.НайтиПоКоду(СтатусТекст);
	
КонецФункции
