Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("ЭкранироватьСтрокуДляHTML")
		.ДобавитьСерверныйТест("ЗаменяетСпецсимволыHTML")
		.ДобавитьСерверныйТест("ПустаяСтрокаHTML")
		.ДобавитьСерверныйТест("ТекстБезСпецсимволовНеизменен");
	
	ЮТТесты.ДобавитьТестовыйНабор("ЭкранироватьСтрокуДляJavaScript")
		.ДобавитьСерверныйТест("ЗаменяетСпецсимволыJS")
		.ДобавитьСерверныйТест("ПустаяСтрокаJS")
		.ДобавитьСерверныйТест("ПереводыСтрокиИКавычки");
	
	ЮТТесты.ДобавитьТестовыйНабор("ПолучитьHTMLMarkdown")
		.ДобавитьСерверныйТест("ВозвращаетЗаполненныйHTMLПросмотрщика");
	
КонецПроцедуры

Процедура ЗаменяетСпецсимволыHTML() Экспорт
	Результат = узОбщийМодульСервер.ЭкранироватьСтрокуДляHTML("<a href=""test&param"">");
	
	ЮТест.ОжидаетЧто(Результат)
		.Равно("&lt;a href=&quot;test&amp;param&quot;&gt;");
КонецПроцедуры

Процедура ПустаяСтрокаHTML() Экспорт
	ЮТест.ОжидаетЧто(узОбщийМодульСервер.ЭкранироватьСтрокуДляHTML("")).Равно("");
КонецПроцедуры

Процедура ТекстБезСпецсимволовНеизменен() Экспорт
	Текст = "Обычный текст 123";
	ЮТест.ОжидаетЧто(узОбщийМодульСервер.ЭкранироватьСтрокуДляHTML(Текст)).Равно(Текст);
КонецПроцедуры

Процедура ЗаменяетСпецсимволыJS() Экспорт
	Результат = узОбщийМодульСервер.ЭкранироватьСтрокуДляJavaScript("путь\к\файлу ""цитата""");
	
	ЮТест.ОжидаетЧто(Результат)
		.Равно("путь\\к\\файлу \""цитата\""");
КонецПроцедуры

Процедура ПустаяСтрокаJS() Экспорт
	ЮТест.ОжидаетЧто(узОбщийМодульСервер.ЭкранироватьСтрокуДляJavaScript("")).Равно("");
КонецПроцедуры

Процедура ПереводыСтрокиИКавычки() Экспорт
	Текст = СтрШаблон("строка1%1строка2%2конец", Символы.ПС, Символы.ВК);
	Результат = узОбщийМодульСервер.ЭкранироватьСтрокуДляJavaScript(Текст);
	
	ЮТест.ОжидаетЧто(Результат).Равно("строка1\nстрока2\rконец");
КонецПроцедуры

Процедура ВозвращаетЗаполненныйHTMLПросмотрщика() Экспорт
	// Функция возвращает навигационную ссылку на макет-просмотрщик во временном хранилище
	HTML = узОбщийМодульСервер.ПолучитьHTMLMarkdown(Новый УникальныйИдентификатор);
	
	ЮТест.ОжидаетЧто(HTML)
		.Заполнено()
		.НачинаетсяС("e1c://")
		.Содержит("tempstorage");
КонецПроцедуры
