// Возвращает день тестовой недели в 12:00; неделя далеко от рабочих данных, чтобы они не мешали.
Функция ДеньТестовойНедели(НомерДня)

	ПонедельникТестовойНедели = Дата(2031, 3, 3);
	Возврат ПонедельникТестовойНедели + (НомерДня - 1) * 86400 + 12 * 3600;

КонецФункции

Функция СоздатьИсполнителя()

	Конструктор = ЮТест.Данные().КонструкторОбъекта("Справочники.Пользователи");
	Конструктор.ФикцияОбязательныхПолей();
	Возврат Конструктор.Записать();

КонецФункции

Функция СоздатьЗадачу()

	Конструктор = ЮТест.Данные().КонструкторОбъекта("Справочники.узЗадачи");
	Конструктор.Установить("Наименование", "Тест табеля задач");
	Конструктор.ФикцияОбязательныхПолей();
	Возврат Конструктор.Записать();

КонецФункции

// Создает и проводит документ ввода факта с одной или двумя строками данных.
Функция СоздатьДокументФакта(Исполнитель, Задача, Дата, Факт, ФактВторойСтроки = Неопределено)

	Конструктор = ЮТест.Данные().КонструкторОбъекта("Документы.узВводФактаПоЗадаче");
	Конструктор.Установить("Дата", Дата);
	Конструктор.Установить("Исполнитель", Исполнитель);
	Конструктор.Установить("Задача", Задача);
	Конструктор.ТабличнаяЧасть("Данные");
	Конструктор.ДобавитьСтроку(СтрокаДанных(Дата, Факт));
	Если ФактВторойСтроки <> Неопределено Тогда
		Конструктор.ДобавитьСтроку(СтрокаДанных(Дата, ФактВторойСтроки));
	КонецЕсли;

	Возврат Конструктор.Провести();

КонецФункции

Функция СтрокаДанных(Дата, Факт)

	Строка = Новый Структура;
	Строка.Вставить("Факт", Факт);
	Строка.Вставить("ДатаОкончания", Дата);
	Строка.Вставить("ДатаНачала", Дата - Факт * 3600);
	Возврат Строка;

КонецФункции

Функция ЧасыПоРегистру(Исполнитель, Задача, День)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ФактПоЗадачам.Факт), 0) КАК Часы
	|ИЗ
	|	РегистрНакопления.узФактПоЗадачам КАК ФактПоЗадачам
	|ГДЕ
	|	ФактПоЗадачам.Исполнитель = &Исполнитель
	|	И ФактПоЗадачам.Задача = &Задача
	|	И ФактПоЗадачам.Период МЕЖДУ &НачалоДня И &КонецДня";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(День));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(День));

	Возврат Запрос.Выполнить().Выгрузить()[0].Часы;

КонецФункции

Функция КоличествоДокументов(Исполнитель, Задача)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументыФакта.Ссылка) КАК Количество
	|ИЗ
	|	Документ.узВводФактаПоЗадаче КАК ДокументыФакта
	|ГДЕ
	|	ДокументыФакта.Исполнитель = &Исполнитель
	|	И ДокументыФакта.Задача = &Задача";
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("Задача", Задача);

	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;

КонецФункции

#КонецОбласти
