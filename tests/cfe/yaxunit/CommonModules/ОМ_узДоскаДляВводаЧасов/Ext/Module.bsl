КонецПроцедуры

Процедура ПереносНаДеньСТойЖеЗадачейДелаетЗаписьМножественной() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Задача = СоздатьЗадачу();
	СДня = ДеньТестовойНедели(1);
	НаДень = ДеньТестовойНедели(3);
	СоздатьДокументФакта(Исполнитель, Задача, СДня, 1);
	СоздатьДокументФакта(Исполнитель, Задача, НаДень, 2);

	Результат = Обработки.узДоскаДляВводаЧасов.Создать().ПеренестиЗапись(Исполнитель, Задача, СДня, НаДень);
	Данные = Обработки.узДоскаДляВводаЧасов.Создать().ПолучитьДанныеНедели(Исполнитель, НаДень);

	ЮТест.ОжидаетЧто(Результат.Успех, Результат.ТекстОшибки).ЭтоИстина();
	ЮТест.ОжидаетЧто(Данные.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Данные[0].Часы).Равно(3);
	ЮТест.ОжидаетЧто(Данные[0].КоличествоДокументов).Равно(2);
	ЮТест.ОжидаетЧто(Данные[0].Множественная).ЭтоИстина();

КонецПроцедуры

Процедура ПереносПриЗапретеВводаФактаОтклоняется() Экспорт

	Исполнитель = СоздатьИсполнителя();
	Задача = СоздатьЗадачу();
	СДня = ДеньТестовойНедели(1);
	Документ = СоздатьДокументФакта(Исполнитель, Задача, СДня, 2);

	ПараметрыСеанса.узЗапретитьВводФактаДляОсновныхЗадач = Истина;
	Попытка
		Результат = Обработки.узДоскаДляВводаЧасов.Создать().ПеренестиЗапись(Исполнитель, Задача, СДня, ДеньТестовойНедели(3));
	Исключение
		ПараметрыСеанса.узЗапретитьВводФактаДляОсновныхЗадач = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	ПараметрыСеанса.узЗапретитьВводФактаДляОсновныхЗадач = Ложь;

	ЮТест.ОжидаетЧто(Результат.Успех).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.ТекстОшибки).Заполнено();
	ЮТест.ОжидаетЧто(Документ.Дата).Равно(СДня);
	ЮТест.ОжидаетЧто(Документ.Проведен).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

