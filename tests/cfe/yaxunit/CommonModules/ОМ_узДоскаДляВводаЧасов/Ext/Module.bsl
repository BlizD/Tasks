Процедура ПроверитьОтказДокументНеИзменен(Часы)

	Исполнитель = СоздатьИсполнителя();
	Задача = СоздатьЗадачу();
	День = ДеньТестовойНедели(1);
	Документ = СоздатьДокументФакта(Исполнитель, Задача, День, 2);

	Результат = Обработки.узДоскаДляВводаЧасов.Создать().ЗаписатьЧасы(Исполнитель, Задача, День, Часы);

