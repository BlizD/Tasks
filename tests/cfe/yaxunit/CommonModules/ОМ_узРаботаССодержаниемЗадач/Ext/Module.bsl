Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ДобавитьТестовыйНабор("ПодставитьСсылкиНаЗадачи")
		.ДобавитьСерверныйТест("ЗаменяеСуществующийНомер")
		.ДобавитьСерверныйТест("НечислоПослеРешеткиНеПадает")
		.ДобавитьСерверныйТест("РешеткаБезЦифр")
		.ДобавитьСерверныйТест("НесуществующаяЗадача")
		.ДобавитьСерверныйТест("ТекстБезРешеток")
		.ДобавитьСерверныйТест("НесколькоСсылок")
		.ДобавитьСерверныйТест("ТекстЗаканчиваетсяНомеромНеПадает")
		.ДобавитьСерверныйТест("ДлиннаяЦифроваяПоследовательностьНеПадает");
	
КонецПроцедуры

Процедура ЗаменяеСуществующийНомер() Экспорт
	Задача = СоздатьТестовуюЗадачу();
	Текст = "Смотри задачу #" + КодЗадачи(Задача) + " плиз";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.НовыйТекст)
		.Содержит("<a href=")
		.Содержит("style='text-decoration: underline'");
КонецПроцедуры

Процедура НечислоПослеРешеткиНеПадает() Экспорт
	Текст = "ссылка на #abc не должна ломать обработку";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.НовыйТекст).Равно(Текст);
КонецПроцедуры

Процедура РешеткаБезЦифр() Экспорт
	Текст = "заголовок # и хвост";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоЛожь();
КонецПроцедуры

Процедура НесуществующаяЗадача() Экспорт
	Текст = "задача #999999999 не существует";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоЛожь();
КонецПроцедуры

Процедура ТекстБезРешеток() Экспорт
	Текст = "обычный текст без ссылок";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.НовыйТекст).Равно(Неопределено);
КонецПроцедуры

Процедура НесколькоСсылок() Экспорт
	Задача = СоздатьТестовуюЗадачу();
	Код = КодЗадачи(Задача);
	Текст = "первая #" + Код + " и вторая #" + Код;
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоИстина();
	// Оба вхождения заменены, дубликат замены не оборачивает ссылку повторно
	ЮТест.ОжидаетЧто(Результат.НовыйТекст)
		.Содержит("<a href=")
		.НеСодержит("</a></a>");
	ЮТест.ОжидаетЧто(СтрЧислоВхождений(Результат.НовыйТекст, "<a href=")).Равно(2);
КонецПроцедуры

Процедура ТекстЗаканчиваетсяНомеромНеПадает() Экспорт
	// Текст заканчивается цифрами: цикл сбора цифр доходит до конца строки, исключений быть не должно
	Текст = "смотри задачу #999";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	// Результат согласованный: замена есть тогда и только тогда, когда задача с кодом 999 существует
	ОжидаемаяЗамена = ЗначениеЗаполнено(Справочники.узЗадачи.НайтиПоКоду(999));
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).Равно(ОжидаемаяЗамена);
	ЮТест.ОжидаетЧто(Результат.НовыйТекст).Заполнено();
КонецПроцедуры

Процедура ДлиннаяЦифроваяПоследовательностьНеПадает() Экспорт
	// 20 цифр - длиннее кода задачи (11), число могло бы переполниться
	Текст = "не код задачи #12345678901234567890";
	
	Результат = узРаботаССодержаниемЗадач.ПодставитьСсылкиНаЗадачи(Текст);
	
	ЮТест.ОжидаетЧто(Результат.ЗаменитьТекст).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.НовыйТекст).Равно(Текст);
КонецПроцедуры

Функция СоздатьТестовуюЗадачу()
	Конструктор = ЮТест.Данные().КонструкторОбъекта("Справочники.узЗадачи");
	Конструктор.Установить("Наименование", "Тест ссылок на задачи");
	Конструктор.ФикцияОбязательныхПолей();
	Возврат Конструктор.Записать();
КонецФункции

Функция КодЗадачи(Задача)
	Возврат XMLСтрока(Задача.Код);
КонецФункции 
